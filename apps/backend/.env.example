# Backend — server-side only. Never commit real values.

# PostgreSQL (Supabase). Use the pooled connection string from the Supabase
# dashboard (Project Settings → Database → Connection string → URI, "Transaction
# pooler" variant for serverless-style deploys).
DATABASE_URL=postgresql://user:password@host:port/database

# Path to the Supabase CA certificate (download from Supabase Dashboard →
# Database Settings → SSL Configuration) for full TLS verification.
# Required in production for non-local databases.
DATABASE_SSL_CA=./prod-ca-2021.crt

# Clerk (server-side only).
CLERK_SECRET_KEY=sk_test_xxx

# Appwrite (server-side only).
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-project-id
APPWRITE_API_KEY=your-api-key
APPWRITE_BUCKET_ID=photos

# Optional dedicated secret for signing public gallery access tokens.
# If unset, one is derived from CLERK_SECRET_KEY.
# GALLERY_TOKEN_SECRET=at-least-16-random-characters

# Optional Redis for BullMQ thumbnail jobs (docker compose up redis).
# Unset → the API processes derivatives with the in-process sweep.
# REDIS_URL=redis://localhost:6379

# Optional Kafka for analytics events (docker compose up kafka).
# Unset → emission is a no-op and galleries serve normally.
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC_ANALYTICS=frameflow.analytics.v1

# Runtime
NODE_ENV=development
PORT=4000

# Frontend environment — copy to .env.local and fill in.
# NEXT_PUBLIC_* values are exposed to the browser; never put secrets here.

# Clerk publishable key exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Required by Clerk's Next.js server middleware. Server-only; never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=

# Express backend base URL. Local default shown; production uses the deployed URL.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk UI routes (set by `clerk init`).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
